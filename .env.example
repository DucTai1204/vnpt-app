# ---------------------------------------------------------------------------
# Frontend (Vite)
# Backend nằm ở source riêng: ../vnpt-api
# ---------------------------------------------------------------------------

# Vite proxy chuyển /api sang địa chỉ này khi chạy dev.
# Chỉ có tác dụng lúc `npm run dev`, không đi vào bundle.
API_URL=http://localhost:4000

# ---------------------------------------------------------------------------
# Build tĩnh (GitHub Pages / APK / .vma) — KHÔNG có proxy đứng trước
# ---------------------------------------------------------------------------

# Gốc tuyệt đối của backend, nhúng vào bundle lúc build.
# Để trống = gọi đường dẫn tương đối /api/v1/... (dev hoặc sau reverse proxy).
# [readme §4] Domain này phải nằm trong `allowedNetworkDomains` của app.json,
# nếu không CSP của Native Shell sẽ chặn.
# VITE_API_BASE_URL=https://nonatomic-unacceptably-fermina.ngrok-free.dev

# Gốc phục vụ ảnh /media/images/*. Mặc định trùng VITE_API_BASE_URL.
# Đặt "." để dùng ảnh đã copy sẵn vào bundle (public/media) — bắt buộc khi
# backend nằm sau ngrok free, vì thẻ <img> không gắn được header bỏ qua trang
# cảnh báo ERR_NGROK_6024.
# VITE_MEDIA_BASE_URL=.

# ---------------------------------------------------------------------------
# AI Studio (giữ nguyên từ template)
# ---------------------------------------------------------------------------
# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
