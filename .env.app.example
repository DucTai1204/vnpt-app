# Cấu hình build APK — copy thành .env.app rồi sửa.
# File này KHÔNG chứa bí mật, chỉ là địa chỉ backend và đường dẫn JDK.

# Gốc backend app sẽ gọi. Bản phát hành BẮT BUỘC https (readme §3.1).
# Domain này cũng phải nằm trong CORS_ORIGINS của backend.
APP_API_URL=https://vnpt-san-api.onrender.com

# JDK 17+ (Capacitor 6 biên dịch ở source level 17). Bỏ trống thì script tự dò.
APP_JAVA_HOME=C:/JAVA_17

# Chỉ đặt true khi APP_API_URL là http:// trong mạng LAN để test.
APP_CLEARTEXT=false
